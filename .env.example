# Offline demo is the default. No accounts, keys or network requests required.
PILOT_MODE=offline
PILOT_DB=./data/processpilot.sqlite3
# Comma-separated Host header allowlist. Add your domain before reverse-proxy/public deployment.
PILOT_ALLOWED_HOSTS=localhost,127.0.0.1,::1,processpilot

# Optional: only when you explicitly want to use a trusted compatible provider.
# PILOT_MODE=remote
# PILOT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# PILOT_LLM_MODEL=qwen2.5:7b
# PILOT_LLM_API_KEY=
# PILOT_LLM_TIMEOUT_SECONDS=15

# Illustrative rates used for cost calculation (NOT live vendor prices).
# PILOT_INPUT_USD_PER_1M=0.25
# PILOT_OUTPUT_USD_PER_1M=1.00
